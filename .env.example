# Content Forge environment template. Copy to .env.local for local development.
# Never commit real secrets. See README.md and SECURITY.md.

# Managed Postgres connection string. When absent, the app runs in
# browser-local demo mode and PUT /api/state reports saved:false.
DATABASE_URL=

# AI provider selection: gemini or openai. Defaults to Gemini when
# GEMINI_API_KEY exists, otherwise OpenAI, otherwise the demo adapter.
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Future official platform integrations (manual/assisted mode until set).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Deployment automation when available.
VERCEL_TOKEN=
